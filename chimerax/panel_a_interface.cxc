# Figure Panel A: GSPT1-CC-90009-CRBN interface.
# Replace MODEL_PATH and OUTPUT_PATH before running this command file.

open "MODEL_PATH"

set bgColor white
lighting soft
hide atoms
hide cartoons

show #1/F cartoons
color #1/F #f0a500
cartoon style #1/F width 1.6 thick 0.4
transparency #1/F 55 target c

show #1/B cartoons
color #1/B cornflower blue
cartoon style #1/B width 1.6 thick 0.4
transparency #1/B 55 target c

show #1/L atoms
style #1/L stick
color #1/L byhetero

show #1/F:533,537,571,572,573,574,575,613,615,625,627 atoms
style #1/F:533,537,571,572,573,574,575,613,615,625,627 stick
color #1/F:533,537,571,572,573,574,575,613,615,625,627 byhetero

show #1/B:149,150,152,351,353,355,357,371,377,386,388,390,397,400 atoms
style #1/B:149,150,152,351,353,355,357,371,377,386,388,390,397,400 stick
color #1/B:149,150,152,351,353,355,357,371,377,386,388,390,397,400 byhetero

contacts #1/F restrict #1/B distanceOnly 3.6 reveal true makePseudobonds true dashes 6 color dim gray radius 0.05 name ccInterface log true

label #1/F:533 text "Q533"
label #1/F:537 text "I537"
label #1/F:571 text "K571"
label #1/F:572 text "K572"
label #1/F:573 text "S573"
label #1/F:574 text "G574"
label #1/F:575 text "E575"
label #1/F:613 text "R613"
label #1/F:615 text "T615"
label #1/F:625 text "I625"
label #1/F:627 text "K627"
label #1/F:533,537,571,572,573,574,575,613,615,625,627 height 1.3 color #a86800 font "Arial Bold"

label #1/B:149 text "D149"
label #1/B:150 text "F150"
label #1/B:152 text "I152"
label #1/B:351 text "N351"
label #1/B:353 text "H353"
label #1/B:355 text "Y355"
label #1/B:357 text "H357"
label #1/B:371 text "I371"
label #1/B:377 text "E377"
label #1/B:386 text "W386"
label #1/B:388 text "V388"
label #1/B:390 text "Q390"
label #1/B:397 text "H397"
label #1/B:400 text "W400"
label #1/B:149,150,152,351,353,355,357,371,377,386,388,390,397,400 height 1.3 color #1f3f9e font "Arial Bold"

view #1/F:533,537,571,572,573,574,575,613,615,625,627 | #1/B:149,150,152,351,353,355,357,371,377,386,388,390,397,400 pad 0.15

save "OUTPUT_PATH" width 2200 height 1700 supersample 3
exit
